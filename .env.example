# ─── Payment Processing & Fraud Detection Platform ─────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to Git.

# ─── Database (PostgreSQL) ──────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fraud_detection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fraud_detection
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MIN=2
DB_POOL_MAX=10

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_KEY_PREFIX=fraud:
REDIS_SOCKET_TIMEOUT=5.0
REDIS_CONNECT_TIMEOUT=5.0
REDIS_IDEMPOTENCY_TTL=3600
REDIS_VELOCITY_TTL=86400

# ─── Kafka ──────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=fraud-detection-group
KAFKA_AUTO_OFFSET_RESET=earliest

# ─── Model Configuration ───────────────────────────────────────────────────
MODEL_PATH=models/trained
MODEL_VERSION=fraud-v1.0
FEATURE_VERSION=features-v1
RULE_VERSION=rules-v1.0

# ─── Risk Thresholds (0-100) ───────────────────────────────────────────────
# Scores below REVIEW are ALLOWED
# Scores between REVIEW and BLOCK are sent to REVIEW
# Scores at or above BLOCK are BLOCKED
RISK_THRESHOLD_REVIEW=30
RISK_THRESHOLD_BLOCK=70

# ─── Ensemble Weights ──────────────────────────────────────────────────────
ML_WEIGHT=0.50
RULE_WEIGHT=0.25
ANOMALY_WEIGHT=0.25

# ─── Fallback Strategy ─────────────────────────────────────────────────────
# What to do when all ML models fail: rule_only, review, block
FALLBACK_STRATEGY=rule_only

# ─── API Configuration ─────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ─── Security ──────────────────────────────────────────────────────────────
# API_KEY=your-secret-api-key-here
# JWT_SECRET=your-jwt-secret-here
